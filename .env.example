# 将本文件复制为 .env 后填写新环境配置；这里不包含现有环境的凭据。

# PostgreSQL，需要安装 pgvector 扩展。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=pdf_warehouse

# CloudMinerU PDF / 二进制 DOC 解析服务。
CLOUDMINERU_API_URL=https://mineru.net/api/v1/agent
CLOUDMINERU_BATCH_API_URL=https://mineru.net/api/v4/file-urls/batch
CLOUDMINERU_API_KEY=

# 文件分类、表格处理及研究抽取使用的 OpenAI 兼容模型。
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_PARENT_CONTEXT_CHARS=600

# 制度问答与语义重排模型，独立于上面的模型配置。
ANSWER_LLM_API_URL=https://api.deepseek.com
ANSWER_LLM_API_KEY=
ANSWER_LLM_MODEL=deepseek-flash
ANSWER_LLM_THINKING=false
POLICY_SEMANTIC_RERANK_ENABLED=true
POLICY_SEMANTIC_RERANK_TIMEOUT_SECONDS=45
POLICY_SEMANTIC_RERANK_CANDIDATES=30

# 嵌入模型可填写模型名称，也可填写新环境中下载好的模型目录。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# 对象存储。即使暂时关闭，也需要保留以下配置项供配置模块加载。
MINIO_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PDF=pdfs
MINIO_BUCKET_IMAGES=images

# 可选 MCP 服务：HTTP 模式必须填写无空格的随机凭据。
POLICY_API_BASE_URL=http://127.0.0.1:8000
POLICY_MCP_HOST=127.0.0.1
POLICY_MCP_PORT=8001
POLICY_MCP_TOKEN=

# 仅在需要这些手动工具时配置。
MINERU_API_URL=http://127.0.0.1:8002/v1/chat/completions
MINERU_API_KEY=
MINERU_MODEL=mineru2.5-1.2b
CHART_API_URL=https://api.openai.com/v1
CHART_API_KEY=
CHART_MODEL=gpt-4o

# 研究功能的可选配置。
KNOWLEDGE_V2_BATCH_SIZE=4
KNOWLEDGE_V2_MAX_TOKENS=2400
KNOWLEDGE_V2_CONTEXT_ANCESTOR_DEPTH=1
